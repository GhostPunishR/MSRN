<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Invitations" android:textSize="24sp" android:textStyle="bold" android:textColor="#172B4D" />
    <TextView android:id="@+id/friend_request_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Sam souhaite vous ajouter (démo)." android:textSize="17sp" />
    <Button android:id="@+id/accept_friend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Accepter" android:textAllCaps="false" />
</LinearLayout>
