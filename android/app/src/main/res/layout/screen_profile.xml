<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingBottom="8dp" android:orientation="vertical">
        <TextView style="@style/MSRN.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:text="@string/profile_title" />
        <LinearLayout style="@style/MSRN.Card">
            <TextView style="@style/MSRN.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_identity" android:labelFor="@id/profile_name" />
            <EditText android:id="@+id/profile_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/profile_display_name" android:singleLine="true" android:maxLength="80" android:inputType="textPersonName" />
            <TextView style="@style/MSRN.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_avatar" android:labelFor="@id/avatar_spinner" />
            <Spinner android:id="@+id/avatar_spinner" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <Button android:id="@+id/save_profile" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_save" />
            <TextView android:id="@+id/profile_status" style="@style/MSRN.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Connectez-vous pour personnaliser votre profil." />
        </LinearLayout>
        <LinearLayout style="@style/MSRN.Card">
            <TextView style="@style/MSRN.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_personal" android:labelFor="@id/personal_message_input" />
            <EditText android:id="@+id/personal_message_input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Votre humeur du jour" android:maxLength="160" android:singleLine="true" />
            <Button android:id="@+id/save_personal_message" style="@style/MSRN.Button.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enregistrer le message" />
            <TextView android:id="@+id/personal_message_status" style="@style/MSRN.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Visible par vos contacts." />
        </LinearLayout>
        <LinearLayout style="@style/MSRN.Card">
            <TextView style="@style/MSRN.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_presence" android:labelFor="@id/presence_spinner" />
            <Spinner android:id="@+id/presence_spinner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" />
            <Button android:id="@+id/save_presence" style="@style/MSRN.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Mettre à jour mon statut" />
            <TextView android:id="@+id/presence_status" style="@style/MSRN.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Choisissez comment apparaître auprès de vos contacts." />
        </LinearLayout>
        <LinearLayout style="@style/MSRN.Card">
            <TextView style="@style/MSRN.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/conversation_sounds_title" />
            <Switch android:id="@+id/message_sound_switch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/message_sound_label" android:textColor="@color/msrn_ink" />
            <Switch android:id="@+id/wizz_sound_switch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/wizz_sound_label" android:textColor="@color/msrn_ink" />
            <TextView style="@style/MSRN.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/conversation_sounds_hint" />
        </LinearLayout>
        <LinearLayout style="@style/MSRN.Card">
            <TextView style="@style/MSRN.Section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profile_account" />
            <Button android:id="@+id/open_auth" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Gérer mon compte" />
            <Button android:id="@+id/check_server" style="@style/MSRN.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/profile_connection" />
            <TextView android:id="@+id/server_status" style="@style/MSRN.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Connexion non vérifiée." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
