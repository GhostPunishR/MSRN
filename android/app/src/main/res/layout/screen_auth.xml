<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="24dp" android:layout_marginBottom="20dp" android:orientation="vertical"
            android:background="@drawable/msrn_scene">
            <TextView style="@style/MSRN.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/auth_title" />
            <TextView style="@style/MSRN.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/auth_caption" />
        </LinearLayout>
        <LinearLayout style="@style/MSRN.Card">
            <TextView android:id="@+id/auth_identity" style="@style/MSRN.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Non connecté" />
            <TextView style="@style/MSRN.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/auth_username" android:labelFor="@id/auth_username" />
            <EditText android:id="@+id/auth_username" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="ex. alex_msrn" android:inputType="textNoSuggestions" android:autofillHints="username"
                android:maxLength="40" android:singleLine="true" />
            <TextView style="@style/MSRN.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/auth_password" android:labelFor="@id/auth_password" />
            <EditText android:id="@+id/auth_password" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Votre mot de passe" android:inputType="textPassword" android:autofillHints="password" android:singleLine="true" />
            <Button android:id="@+id/auth_login" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/auth_signin" />
            <TextView style="@style/MSRN.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/auth_display_name" android:labelFor="@id/auth_display_name" />
            <EditText android:id="@+id/auth_display_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Comment vous appelle-t-on ?" android:inputType="textPersonName" android:autofillHints="name"
                android:maxLength="80" android:singleLine="true" />
            <Button android:id="@+id/auth_register" style="@style/MSRN.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/auth_signup" />
            <Button android:id="@+id/auth_logout" style="@style/MSRN.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/auth_logout" />
            <TextView android:id="@+id/auth_status" style="@style/MSRN.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Connectez-vous au serveur MSRN." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
