<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Camille (démo)" android:textSize="24sp" android:textStyle="bold" android:textColor="#172B4D" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/chat_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="18dp" android:textColor="#172B4D" android:textSize="17sp" />
    </ScrollView>
    <EditText android:id="@+id/message_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Écrire un message" android:inputType="textCapSentences|textMultiLine" android:maxLength="4000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/send_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Envoyer" android:textAllCaps="false" />
        <Button android:id="@+id/send_wizz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wizz !" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
