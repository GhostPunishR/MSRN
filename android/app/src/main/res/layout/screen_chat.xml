<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/chat_title" android:text="Choisissez un contact" android:textSize="24sp" android:textStyle="bold" android:textColor="#172B4D" />
    <TextView android:id="@+id/chat_contact_profile" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#65758B"
        android:text="Profil du contact" />
    <Button android:id="@+id/load_older_messages" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Charger les anciens messages"
        android:textAllCaps="false" android:enabled="false" />
    <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/chat_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" />
    </ScrollView>
    <TextView android:id="@+id/chat_typing" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="" android:textColor="#65758B" />
    <TextView android:id="@+id/chat_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sélectionnez un contact dans Contacts." android:textColor="#65758B" />
    <Button android:id="@+id/refresh_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actualiser les messages" android:textAllCaps="false" />
    <EditText android:id="@+id/message_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Écrire un message" android:inputType="textCapSentences|textMultiLine" android:maxLength="4000" />
    <Button android:id="@+id/toggle_emoji" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Émoticônes 🙂"
        android:textAllCaps="false" />
    <HorizontalScrollView android:id="@+id/emoji_palette" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone"
        android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/emoji_items" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/send_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Envoyer" android:textAllCaps="false" />
        <Button android:id="@+id/send_wizz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Envoyer un Wizz" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
